# Copy this file to .env and fill in real values. .env is gitignored.

# Cloudflare Tunnel token.
#
# Zero Trust dashboard -> Networks -> Tunnels -> <your tunnel> -> Configure.
# Copy the token out of the shown install command (the long string after
# `--token`), not the whole command.
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Bearer token guarding /admin/bootstrap and /admin/cache.
# The server refuses to start if this is unset.
#
# Generate one with:
#   openssl rand -hex 32
STRAVA_ADMIN_TOKEN=generate_a_random_token
