# Cloudflare Tunnel token.
#
# Zero Trust dashboard -> Networks -> Tunnels -> <your tunnel> -> Configure.
# Copy the token out of the shown install command (the long string after
# `--token`), not the whole command.
#
# Copy this file to .env and paste the real value. .env is gitignored.
# Treat the token as a credential: it grants the ability to serve traffic on
# your hostname.

TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
